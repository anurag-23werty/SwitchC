# Khata runtime configuration. Copy to .env and fill in.
# Switch's own server secrets live separately in switch/stack/.env (make switch-env).

# --- Switch ---------------------------------------------------------------
# The agent bridge base URL (GET /health must answer 200 here).
SWITCH_API_URL=http://localhost:8000
# Must equal AGENT_REGISTRATION_TOKEN in switch/stack/.env.
# `make env` copies it across for you.
SWITCH_REGISTRATION_TOKEN=
# Gateway (admin) login, used only to set agents' addressing policies.
SWITCH_GATEWAY_URL=http://localhost:8000
SWITCH_GATEWAY_EMAIL=admin@switch.local
SWITCH_GATEWAY_PASSWORD=

# --- Khata database ---------------------------------------------------------
KHATA_DATABASE_URL=postgresql://khata:khata@localhost:5433/khata

# --- LLM providers (free tiers; no credit card) ------------------------------
# Primary: Groq. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
# Second, independent provider: OpenRouter free models. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional overrides (defaults in khata/config.py)
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,xingchen-agi/xing4.0-29b-a4b:free
# GROQ_SECONDARY_MODEL=qwen/qwen3.8-27b
# GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
